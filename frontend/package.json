{
	"name": "etcslauncher",
	"appId": "etcs.ebd.etcslauncher.app",
	"productName": "ETCS-Launcher",
	"description": "The ETCS-Launcher allows you to manage and run different ETCS-Modules.",
	"version": "1.1.0",
	"author": "ETCS@EBD",
	"private": true,
	"main": "dist/main.cjs",
	"scripts": {
		"dev": "cross-env NODE_ENV=dev npm run dev:all",
		"dev:all": "concurrently -n=svelte,electron -c='#ff3e00',blue \"npm run dev:svelte\" \"npm run dev:electron\"",
		"dev:svelte": "vite dev",
		"dev:electron": "electron dist/main.cjs",
		"rename:win": "C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe -ExecutionPolicy Unrestricted -File renameWIN.ps1",
		"rename:unix": "cd dist; find . -type f -name \"*.js\" -exec bash -c 'mv \"$1\" \"${1%.js}.cjs\"' _ {} \\; && find . -type f -name \"*.js.map\" -exec bash -c 'mv \"$1\" \"${1%.js.map}.cjs.map\"' _ {} \\;",
		"build:typescript": "tsc --p tsconfig.electron.json && npm run rename:unix",
		"build:svelte": "vite build",
		"build:electron": "electron-builder --config build.config.yml -wm",
		"build:electron:windows": "electron-builder --config build.config.yml -w",
		"build:production": "npm run build:typescript && npm run build:svelte && npm run build:electron",
		"test:unit": "npx vitest test",
		"test:end2end": "npx playwright test",
		"test:all": "npm run test:unit && npm run test:end2end"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@ptkdev/sveltekit-electron-adapter": "^0.3.0",
		"@skeletonlabs/skeleton": "4.15.2",
		"@skeletonlabs/tw-plugin": "0.4.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.67.0",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "26.0.0",
		"@types/stompjs": "^2.3.9",
		"@typescript-eslint/eslint-plugin": "^8.62.0",
		"@typescript-eslint/parser": "^8.62.0",
		"ansi_up": "^6.0.2",
		"autoprefixer": "10.5.1",
		"concurrently": "^10.0.3",
		"cross-env": "^10.1.0",
		"electron": "42.0.0-alpha.5",
		"electron-builder": "^26.15.3",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"msw": "^2.3.1",
		"playwright": "^1.61.1",
		"postcss": "8.5.10",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^3.2.6",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"svelte-tiny-virtual-list": "^3.0.1",
		"tailwindcss": "3.3.0",
		"tslib": "^2.6.3",
		"typescript": "^6.0.3",
		"vite": "6.0.0",
		"vite-plugin-tailwind-purgecss": "0.3.5",
		"vitest": "^4.1.9",
		"websocket": "^1.0.35"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.6.7",
		"@stomp/stompjs": "^7.0.0",
		"electron-context-menu": "^4.1.2",
		"electron-reloader": "^1.2.3",
		"electron-serve": "^3.0.1",
		"electron-window-state": "^5.0.3",
		"highlight.js": "11.11.1",
		"stompjs": "^2.3.3"
	}
}
